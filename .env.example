# MongoDB Atlas connection string.
# Atlas: Connect -> Drivers -> copy, then replace <password> with the real one.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"

# Database inside the cluster. Created on first write.
MONGODB_DB="flashcards"

# Shared secret for the HTTP API. Send it as the x-api-key header.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
FLASHCARDS_API_KEY=""

# The single account that can sign in to the web app.
# Generate both of these interactively with: npm run set-password
#
# In THIS FILE every "$" in the hash must be escaped as "\$". Dotenv expands
# $NAME as a variable, and a bcrypt hash is $2b$12$..., so an unescaped hash is
# silently read as an empty string and the app reports no account configured.
# On Vercel and other hosts, paste the hash raw -- nothing expands it there.
#   AUTH_PASSWORD_HASH="\$2b\$12\$abcdef..."
AUTH_USER_EMAIL=""
AUTH_PASSWORD_HASH=""

# Signs the session cookie. Any long random string; changing it signs you out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Evening reminders (phone notifications). Generate all three, and optionally
# send them to Vercel, with: npm run setup-reminders [-- --vercel]
# The key pair signs every notification; CRON_SECRET is what Vercel Cron sends
# to /api/cron/reminders. Without these, reminders stay off.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
CRON_SECRET=""
# Optional contact for the push services. Defaults to AUTH_USER_EMAIL.
# VAPID_SUBJECT="mailto:you@example.com"

# Watch & learn: optional backup for fetching YouTube transcripts.
# YouTube refuses caption requests from most cloud servers (Vercel included),
# so on the deployed app the free fetch often fails. With a key from
# https://supadata.ai the server asks Supadata instead. Leave empty to use only
# the free fetch and the upload box.
SUPADATA_API_KEY=""

# Watch & learn: optional AI meanings. With a key from https://openrouter.ai a
# tapped word gets a short meaning for the way the video's sentence uses it,
# instead of the dictionary's list. Leave empty to use the free dictionaries.
OPENROUTER_API_KEY=""
# Optional: any OpenRouter model id. Defaults to google/gemini-3.1-flash-lite.
# OPENROUTER_MODEL=""

# Watch & learn: optional natural AI voice for the speaker button. A free key
# from https://aistudio.google.com/apikey. Each phone keeps the words it has heard.
# Leave empty to use the device's own voice.
GEMINI_API_KEY=""
# Optional: any of Google's 30 prebuilt voices. Defaults to Kore.
# GEMINI_VOICE=""
# Optional: the text-to-speech model. Defaults to gemini-3.8-flash-lite-tts.
# GEMINI_VOICE_MODEL=""
